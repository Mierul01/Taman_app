rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOfPark(parkName) {
      return isSignedIn() && myProfile().role == 'admin' && myProfile().parkName == parkName;
    }

    function isCommitteeOfPark(parkName) {
      return isSignedIn()
        && myProfile().role in ['admin', 'ajk', 'treasurer', 'chairman']
        && myProfile().parkName == parkName;
    }

    function isTreasuryOfPark(parkName) {
      return isSignedIn()
        && myProfile().role in ['admin', 'treasurer', 'chairman']
        && myProfile().parkName == parkName;
    }

    // One document per account, keyed by Firebase Auth uid.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn()
        && (request.auth.uid == userId || isAdminOfPark(resource.data.parkName));
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Self-reported fee/charity payments. Never editable or deletable once
    // recorded (this is an honor-system ledger, not a real payment gateway).
    match /paymentRecords/{recordId} {
      allow read: if isSignedIn()
        && (resource.data.userEmail == request.auth.token.email
            || myProfile().parkName == resource.data.parkName);
      allow create: if isSignedIn() && request.resource.data.userEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    // Park programs/events. Anyone signed in can read; only that park's
    // committee (AJK/treasurer/chairman/admin) can create, edit or remove one.
    match /programs/{programId} {
      allow read: if isSignedIn();
      allow create: if isCommitteeOfPark(request.resource.data.parkName);
      allow update, delete: if isCommitteeOfPark(resource.data.parkName) || isAdminOfPark(resource.data.parkName);
    }

    // One bank-account-details doc per park (doc id = encodeURIComponent(parkName)).
    match /bankAccounts/{parkId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && myProfile().role in ['admin', 'treasurer', 'chairman'];
    }

    // Fee item names/amounts per park (doc id = encodeURIComponent(parkName), and
    // the doc itself carries a plain parkName field so this rule can check it
    // without needing to decode the id). Anyone in the park can read them to
    // pay; only that park's treasury roles can edit.
    match /feeSettings/{parkId} {
      allow read: if isSignedIn();
      allow write: if isTreasuryOfPark(request.resource.data.parkName);
    }

    // Public directory of registered park names (doc id = encodeURIComponent(parkName)),
    // holding only the name itself. Read publicly so the Register screen can offer
    // existing parks in a dropdown before the visitor has an account; writes require
    // auth since a park is only added once someone actually registers into it.
    match /parks/{parkId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
